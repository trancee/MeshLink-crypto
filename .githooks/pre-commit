#!/usr/bin/env bash
# git pre-commit hook.
#
# Purpose:
#   Run ktfmt formatting check and detekt lint on changed files.
#   Non-blocking surf — prints warnings, exits 0.
#
# Activate (one time per clone):
#   git config core.hooksPath .githooks

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)" || exit 0
cd "$ROOT" || exit 0

# Run formatting check (ktfmt via spotless).
echo "[format] checking ktfmt formatting..."
if ! ./gradlew :crypto:spotlessCheck --rerun --no-build-cache --quiet 2>&1; then
  echo "[format] WARNING: spotlessCheck failed — files are not ktfmt-formatted." >&2
  echo "[format] Run: ./gradlew :crypto:spotlessApply --rerun --no-build-cache" >&2
fi

exit 0
