# Copy to .env and fill in your credentials.
# NEVER commit .env — it is listed in .gitignore.
#
# These are required for Maven Central publishing via the Central Portal
# Publisher API (bundle upload). See .github/workflows/publish.yml.
#
# CI passes all credentials as environment variables, not -P flags,
# because the PGP key block (SIGNING_KEY) is multi-line.
#
# Central Portal User Token — used by CI to compute the Bearer token
# for POST /api/v1/publisher/upload (skill: central-portal-publish §2).
# Generate at https://central.sonatype.com/publishing/user-tokens → "Generate User Token".
MAVEN_CENTRAL_USERNAME=
MAVEN_CENTRAL_PASSWORD=
#
# ASCII-armored PGP private key block — passed to CI as environment variable
# ORG_GRADLE_PROJECT_signingInMemoryKey → Gradle project property
# "signingInMemoryKey". The build script's signing block reads this property
# explicitly via useInMemoryPgpKeys() and passes it to the signing plugin.
# Export with:
#   gpg --armor --export-secret-keys <KEY_ID> > key.asc
# Copy the ENTIRE file (including BEGIN/END headers) into SIGNING_KEY.
SIGNING_KEY=
# Passphrase for the PGP key — passed to CI as environment variable
# ORG_GRADLE_PROJECT_signingInMemoryKeyPassword → Gradle project property
# "signingInMemoryKeyPassword". The build script reads this for useInMemoryPgpKeys().
SIGNING_KEY_PASSWORD=
